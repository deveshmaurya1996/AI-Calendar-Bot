
ENVIRONMENT=development
DEBUG=True
API_TITLE=AI Calendar Scheduling
API_VERSION=1.0.0

POLLINATIONS_API_KEY=your_sk_or_pk_key_here
POLLINATIONS_MODEL=openai

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

GOOGLE_CALENDAR_ID=primary

GOOGLE_APPOINTMENT_SCHEDULE_URL=

GOOGLE_CALENDAR_ADMIN_EMAILS=admin@yourdomain.com
FRONTEND_PUBLIC_URL=http://localhost:3000

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# Optional: password gate for API routes (see README)
# APP_LOGIN_USERNAME=
# APP_LOGIN_PASSWORD=
# SESSION_EXPIRE_DAYS=7

LOG_LEVEL=INFO